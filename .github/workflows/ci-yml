# .github/workflows/main.yml
name: Deploy Terraform App to Azure

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  # The 'lint-and-scan' job remains exactly the same. No changes needed.
  lint-and-scan:
    name: Lint and Scan Code
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3
      # ... (all the terraform fmt, init, validate, tflint, tfsec steps are identical)

  build-and-deploy:
    name: Build and Deploy to Azure
    runs-on: ubuntu-latest
    needs: lint-and-scan

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      # AZURE: Log in using the Service Principal
      - name: 'Az CLI login'
        uses: azure/login@v1
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v2

      - name: Terraform Init
        run: terraform init
        working-directory: ./terraform
        env: # We pass the SP credentials to Terraform
          ARM_CLIENT_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).clientId }}
          ARM_CLIENT_SECRET: ${{ fromJson(secrets.AZURE_CREDENTIALS).clientSecret }}
          ARM_SUBSCRIPTION_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).subscriptionId }}
          ARM_TENANT_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).tenantId }}

      - name: Terraform Apply
        run: terraform apply -auto-approve
        working-directory: ./terraform
        env: # Also need the creds for apply step
          ARM_CLIENT_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).clientId }}
          ARM_CLIENT_SECRET: ${{ fromJson(secrets.AZURE_CREDENTIALS).clientSecret }}
          ARM_SUBSCRIPTION_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).subscriptionId }}
          ARM_TENANT_ID: ${{ fromJson(secrets.AZURE_CREDENTIALS).tenantId }}

      # The Ansible and Docker steps are identical to the AWS pipeline
      - name: Setup Ansible
        run: |
          sudo apt-add-repository --yes --update ppa:ansible/ansible
          sudo apt-get install -y ansible
      
      - name: Build and Save Docker image
        run: |
          docker build -t my-webapp:1.0 ./app
          docker save my-webapp:1.0 > ./ansible/my-webapp-1.0.tar

      - name: Run Ansible Playbook
        run: |
          cd ansible
          ansible-playbook -i inventory playbook.yml --extra-vars "docker_image_path=/tmp/my-webapp-1.0.tar"
        env:
          ANSIBLE_HOST_KEY_CHECKING: "False"
          # In a real pipeline, you'd get the app secret from a production Vault
          # For now, we are simulating this.